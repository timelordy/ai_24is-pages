{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "inception/mercury-3",
  "provider": {
    "inception": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Inception",
      "options": {
        "baseURL": "https://api.inceptionlabs.ai/v1"
      },
      "models": {
        "mercury-3": {
          "name": "Mercury3"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "external_directory": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  }
}
